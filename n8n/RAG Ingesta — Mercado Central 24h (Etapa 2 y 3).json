      "id": "06498206-1317-4554-9e43-9e315bbbd4c4",
      "name": "Extraer Filas Excel",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [
        896,
        112
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const row = $json;\nconst name = ($('Descargar Archivo').item.json.name || 'inventario_de_supermercado_latam.xlsx').toString();\nconst skip = ['content', 'nombre_archivo', 'categoria', 'responsable'];\n\nconst parts = [];\nfor (const key of Object.keys(row)) {\n  if (skip.includes(key)) continue;\n  const value = row[key];\n  if (value !== null && value !== undefined && String(value).trim() !== '') {\n    parts.push(key + ': ' + value);\n  }\n}\n\nconst content = parts.join(' | ');\n\n// Si la fila queda vacía, no generamos fragmento\nif (!content) {\n  return { json: { content: '', nombre_archivo: name, categoria: 'inventario', responsable: 'Gerencia de Logística', _skip: true } };\n}\n\nreturn {\n  json: {\n    content,\n    nombre_archivo: name,\n    categoria: 'inventario',\n    responsable: 'Gerencia de Logística',\n  },\n};"
      },
