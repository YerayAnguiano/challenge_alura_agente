      "id": "966118f1-cbb4-40eb-abec-fbe8c22ad20b",
      "name": "Extraer Texto PDF",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [
        896,
        304
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const text = ($json.text || $json.data || '').toString().trim();\nconst name = ($('Descargar Archivo').item.json.name || '').toString();\nconst lower = name.toLowerCase();\n\n// Mapeo categoria/responsable por nombre de archivo (metadata.json)\nlet categoria = 'atencion_cliente';\nlet responsable = 'Dirección de Servicio al Cliente';\n\nif (lower.includes('inventario')) {\n  categoria = 'inventario';\n  responsable = 'Gerencia de Logística';\n} else if (lower.includes('atenci') || lower.includes('devoluc')) {\n  categoria = 'atencion_cliente';\n  responsable = 'Dirección de Servicio al Cliente';\n} else if (lower.includes('preguntas frecuentes') || lower.includes('faq')) {\n  categoria = 'faq';\n  responsable = 'Operaciones & App VIP';\n} else if (lower.includes('reglamento')) {\n  categoria = 'rh';\n  responsable = 'Departamento de RH';\n} else if (lower.includes('proveedor') || lower.includes('compras')) {\n  categoria = 'finanzas_compras';\n  responsable = 'Departamento de Compras';\n}\n\nreturn { json: { content: text, nombre_archivo: name, categoria, responsable } };"
      },
      "id": "7df4269d-e1ff-4650-87ca-7e72a70b5213",
